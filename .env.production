# =============================================================================
# .env.example — Environment variable reference for Excalidraw
# =============================================================================
#
# Copy this file to .env.production and fill in your values:
#   cp .env.example .env.production
#
# IMPORTANT — Build-time vs. Runtime:
#   All VITE_APP_* variables are compiled into the JS bundle by Vite at build
#   time (import.meta.env.* is replaced with literal strings).
#
#   When running in Docker, these values can be OVERRIDDEN at container start
#   time WITHOUT rebuilding: docker-entrypoint.sh uses envsubst to substitute
#   them into index.html from the container's environment. This means you can
#   run the same Docker image against different environments.
#
#   Variables marked [BUILD-TIME ONLY] are baked in at build and cannot be
#   changed at container start. Variables marked [RUNTIME-INJECTABLE] can be
#   overridden via Docker env vars.
#
# IMPORTANT — Security:
#   Firebase API keys, app IDs, etc. are CLIENT-SIDE credentials. They are
#   intentionally public (they appear in the compiled JS bundle served to
#   browsers). Security is enforced by Firebase Security Rules, not by keeping
#   keys secret. See: https://firebase.google.com/docs/projects/api-keys
#
#   The only secret in this file is VITE_APP_PLUS_EXPORT_PUBLIC_KEY — an RSA
#   public key used for Excalidraw+ export encryption. This is also safe to
#   commit since it is a PUBLIC key.
#
# =============================================================================


# =============================================================================
# REQUIRED — Core Features
# These variables must be set for basic collaboration and sharing to work.
# Without them, the app still loads but collaboration and share links fail.
# =============================================================================

# --- Firebase Configuration --------------------------------------------------
# REQUIRED for: real-time collaboration (scene persistence) and file uploads.
#
# Must be a valid JSON string (single-quoted to allow inner double quotes).
# Get this from Firebase Console → Project Settings → Your apps → Web app.
#
# The Firebase project needs:
#   - Firestore Database (for storing collaboration scenes)
#   - Cloud Storage (for storing embedded images/files)
#
# How to get your config:
#   1. Go to https://console.firebase.google.com
#   2. Create a project (or select existing)
#   3. Add a Web App (</> icon)
#   4. Copy the firebaseConfig object values into the JSON string below
#
# Example format (replace ALL values with your own):
VITE_APP_FIREBASE_CONFIG='{"apiKey":"YOUR_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","databaseURL":"https://YOUR_PROJECT.firebaseio.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_PROJECT.appspot.com","messagingSenderId":"YOUR_SENDER_ID","appId":"YOUR_APP_ID"}'
# [RUNTIME-INJECTABLE]

# --- Shareable Link Backend --------------------------------------------------
# REQUIRED for: the "Export Link" feature (creating shareable drawing URLs).
#
# ⚠️  IMPORTANT: json.excalidraw.com is Excalidraw's own hosted service and
#    is NOT open source. If you leave these pointing to json.excalidraw.com,
#    shared drawings will be stored on Excalidraw's servers (not your own).
#    This may be acceptable for internal use but is a privacy concern for
#    sensitive data.
#
#    To fully self-host: you would need to build a compatible REST API that
#    accepts POST requests with binary payloads and returns {"id": "..."},
#    then stores/retrieves them by ID. The format is a zlib-compressed,
#    AES-GCM-encrypted binary blob.
VITE_APP_BACKEND_V2_GET_URL=https://json.excalidraw.com/api/v2/
VITE_APP_BACKEND_V2_POST_URL=https://json.excalidraw.com/api/v2/post/
# [RUNTIME-INJECTABLE]

# --- Real-Time Collaboration WebSocket Server --------------------------------
# REQUIRED for: multi-user live collaboration (the "Live collaboration" button).
#
# This must point to a running excalidraw-room server:
#   https://github.com/excalidraw/excalidraw-room
#
# excalidraw-room is a separate Node.js/Socket.IO relay server that you must
# deploy independently. It does NOT store data — it only relays encrypted
# WebSocket messages between clients in the same room.
#
# For local development: http://localhost:3002
# For production self-hosted: https://collab.yourdomain.com
# For Excalidraw's public server (shared with all excalidraw.com users):
#   https://oss-collab.excalidraw.com  ← default (uses their server)
VITE_APP_WS_SERVER_URL=https://oss-collab.excalidraw.com
# [RUNTIME-INJECTABLE]


# =============================================================================
# OPTIONAL — Library Features
# Excalidraw's public shape library. These point to Excalidraw's own hosted
# library service. You can leave these as-is for community library access.
# =============================================================================

# URL for the shape library browser UI
VITE_APP_LIBRARY_URL=https://libraries.excalidraw.com
# [RUNTIME-INJECTABLE]

# URL for the library API (Firebase Cloud Function, Excalidraw-hosted)
VITE_APP_LIBRARY_BACKEND=https://us-central1-excalidraw-room-persistence.cloudfunctions.net/libraries
# [RUNTIME-INJECTABLE]


# =============================================================================
# OPTIONAL — AI Features (Text-to-diagram / Mermaid diagram generation)
# Leave empty to hide the AI features from the UI entirely.
# =============================================================================

# Backend URL for the AI diagram generation feature.
# Must implement the AI API compatible with excalidraw's AI component.
# Leave empty to disable AI features.
VITE_APP_AI_BACKEND=
# [RUNTIME-INJECTABLE]


# =============================================================================
# OPTIONAL — Excalidraw Plus Integration
# Only relevant if you are integrating with the Excalidraw Plus paid service.
# Leave empty or as-is if you are not using Excalidraw Plus.
# =============================================================================

# Landing page URL for Excalidraw Plus (shown in upgrade prompts)
VITE_APP_PLUS_LP=https://plus.excalidraw.com
# [RUNTIME-INJECTABLE]

# Application URL for Excalidraw Plus (used for Plus user redirects and export)
VITE_APP_PLUS_APP=https://app.excalidraw.com
# [RUNTIME-INJECTABLE]

# RSA public key for Excalidraw Plus export encryption.
# This is a PUBLIC key — safe to commit. Only relevant if users export drawings
# to Excalidraw Plus. Leave empty if not integrating with Plus.
VITE_APP_PLUS_EXPORT_PUBLIC_KEY=
# [RUNTIME-INJECTABLE]


# =============================================================================
# OPTIONAL — Error Monitoring (Sentry)
# =============================================================================

# Set to "true" to disable Sentry error tracking entirely.
# Sentry is automatically disabled when running in Docker (the DSN in sentry.ts
# is hostname-gated to excalidraw.com and *.vercel.app) unless you
# customize sentry.ts with your own DSN.
#
# If you integrate your own Sentry DSN in sentry.ts, set this to "false"
# to enable error tracking for your deployment.
VITE_APP_DISABLE_SENTRY=true
# [RUNTIME-INJECTABLE]


# =============================================================================
# OPTIONAL — Build Metadata
# These are set automatically by CI/CD pipelines. You rarely need to set
# them manually.
# =============================================================================

# Git commit SHA for Sentry release tracking and the /version.json endpoint.
# Automatically set by the Dockerfile build arg (ARG GIT_SHA=docker-build).
# In CI, pass: --build-arg GIT_SHA=$(git rev-parse --short HEAD)
# VITE_APP_GIT_SHA=
# [BUILD-TIME ONLY — cannot be overridden at container start]


# =============================================================================
# OPTIONAL — Development-Only Variables
# These are only meaningful when running `yarn start` locally.
# They have no effect in Docker / production builds.
# =============================================================================

# Port for the Vite dev server (default: 3001)
# VITE_APP_PORT=3001

# Set to "true" to disable the browser "You have unsaved changes" dialog.
# Useful for rapid dev iteration.
# VITE_APP_DISABLE_PREVENT_UNLOAD=true

# Set to "true" to enable ESLint checking in the Vite dev server overlay.
# VITE_APP_ENABLE_ESLINT=true

# Set to "true" to enable PWA service worker in development mode.
# Normally off during dev to avoid caching issues.
# VITE_APP_ENABLE_PWA=false

# Set to "false" to show the Vite type/lint error overlay open by default.
# VITE_APP_COLLAPSE_OVERLAY=true

# Set to "true" to disable Vite HMR (useful when debugging service workers).
# VITE_APP_DEV_DISABLE_LIVE_RELOAD=false


# =============================================================================
# Docker Compose (docker-compose.prod.yml)
# =============================================================================

# Host port to expose the Excalidraw SPA on (default: 8080)
# docker-compose.prod.yml maps ${EXCALIDRAW_PORT:-8080}:80
EXCALIDRAW_PORT=8080

# =============================================================================
# Deployment Settings (AWS / OCI)
# =============================================================================
DOMAIN=13.60.231.11.nip.io
CERTBOT_EMAIL=admin@example.com
AWS_REGION=eu-north-1
ECR_REPOSITORY=excalidraw
IMAGE_TAG=latest

